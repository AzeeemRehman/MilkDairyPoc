DATABASE_URL="postgresql://dairy:dairy@localhost:5433/dairy?schema=public"
# Separate database used by the integration tests (wiped on every run)
TEST_DATABASE_URL="postgresql://dairy:dairy@localhost:5433/dairy_test?schema=public"
# Where expense receipt uploads are stored (outside the web root)
UPLOAD_DIR="./storage/uploads"
# Initial admin created by the seed script (change the password after first login)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-now"
