// Dairy Milk Supply & Financial Management System
// All money and quantity columns are NUMERIC (Prisma Decimal). See PLANNING.md §4.2 / §6.
// Constraints Prisma cannot express (partial unique indexes, EXCLUDE, CHECK, closed-period
// trigger) live in prisma/migrations/*_constraints/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplyType {
  BANDHI
  MANDI
}

enum CustomerType {
  BANDHI
  MANDI
  BOTH
}

enum MilkSession {
  MORNING
  EVENING
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum TxnType {
  OPENING
  BANDHI_CHARGE
  MANDI_CHARGE
  PAYMENT
  CASH_ADJ
  ADDITIONAL_CHARGE
  DISCOUNT
  REFUND
  DEBIT_ADJ
  CREDIT_ADJ
  REVERSAL
}

enum SourceType {
  OPENING_BALANCE
  MILK_ENTRY
  PAYMENT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  BANK
  JAZZCASH
  EASYPAISA
  OTHER
}

enum AdjustmentType {
  ADDITIONAL_CHARGE
  DISCOUNT
  REFUND
  CASH_ADJ
  DEBIT_ADJ
  CREDIT_ADJ
}

enum PeriodStatus {
  OPEN
  CLOSED
  REOPENED
}

enum StatementStatus {
  DRAFT
  FINAL
  SUPERSEDED
}

enum PaidStatus {
  UNPAID
  PARTIAL
  PAID
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model User {
  id             String    @id @default(cuid())
  name           String
  username       String    @unique
  passwordHash   String
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  locale         String    @default("en")
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  nameUr             String?
  businessName       String?
  contactPerson      String?
  mobile             String?
  whatsapp           String?
  address            String?
  city               String?
  customerType       CustomerType   @default(BANDHI)
  openingBalance     Decimal        @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime?      @db.Date
  status             ActiveStatus   @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now())
  createdBy          String?
  updatedAt          DateTime       @updatedAt
  updatedBy          String?
  rates              CustomerRate[]
  milkEntries        MilkEntry[]
  ledger             LedgerEntry[]
  payments           Payment[]
  adjustments        Adjustment[]
  statements         MonthlyStatement[]

  @@index([name])
  @@index([city])
  @@index([status])
}

/// Rate history: a new row per change; old rows only get effectiveTo closed.
model CustomerRate {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  supplyType    SupplyType
  session       MilkSession
  defaultMaan   Decimal     @default(0) @db.Decimal(10, 3)
  defaultKg     Decimal     @default(0) @db.Decimal(10, 3)
  ratePerMaan   Decimal     @db.Decimal(12, 4)
  ratePerKg     Decimal     @db.Decimal(12, 4)
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  createdBy     String?

  @@index([customerId, supplyType, session, effectiveFrom])
}

model MilkEntry {
  id          String             @id @default(cuid())
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  entryDate   DateTime           @db.Date
  supplyType  SupplyType
  period      String             @db.VarChar(7)
  totalAmount Decimal            @db.Decimal(14, 2)
  noSupply    Boolean            @default(false)
  notes       String?
  createdAt   DateTime           @default(now())
  createdBy   String?
  updatedAt   DateTime           @updatedAt
  updatedBy   String?
  voidedAt    DateTime?
  voidedBy    String?
  voidReason  String?
  sessions    MilkEntrySession[]

  @@index([entryDate])
  @@index([period, customerId])
}

model MilkEntrySession {
  id             String      @id @default(cuid())
  milkEntryId    String
  milkEntry      MilkEntry   @relation(fields: [milkEntryId], references: [id], onDelete: Cascade)
  session        MilkSession
  maan           Decimal     @default(0) @db.Decimal(10, 3)
  kg             Decimal     @default(0) @db.Decimal(10, 3)
  ratePerMaan    Decimal     @db.Decimal(12, 4)
  ratePerKg      Decimal     @db.Decimal(12, 4)
  amount         Decimal     @db.Decimal(14, 2)
  rateOverridden Boolean     @default(false)

  @@unique([milkEntryId, session])
}

model LedgerEntry {
  id          String        @id @default(cuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  txnNo       String        @unique
  txnDate     DateTime      @db.Date
  period      String        @db.VarChar(7)
  txnType     TxnType
  description String
  debit       Decimal       @default(0) @db.Decimal(14, 2)
  credit      Decimal       @default(0) @db.Decimal(14, 2)
  sourceType  SourceType
  sourceId    String
  reversesId  String?
  reverses    LedgerEntry?  @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  LedgerEntry[] @relation("Reversal")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  createdBy   String?

  @@index([customerId, txnDate])
  @@index([period])
  @@index([sourceType, sourceId])
}

model Payment {
  id          String              @id @default(cuid())
  receiptNo   String              @unique
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  paymentDate DateTime            @db.Date
  amount      Decimal             @db.Decimal(14, 2)
  method      PaymentMethod       @default(CASH)
  reference   String?
  notes       String?
  createdAt   DateTime            @default(now())
  createdBy   String?
  voidedAt    DateTime?
  voidedBy    String?
  voidReason  String?
  allocations PaymentAllocation[]

  @@index([customerId, paymentDate])
  @@index([paymentDate])
}

/// statementId NULL = allocated to the customer's opening balance.
model PaymentAllocation {
  id          String            @id @default(cuid())
  paymentId   String
  payment     Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  statementId String?
  statement   MonthlyStatement? @relation(fields: [statementId], references: [id])
  amount      Decimal           @db.Decimal(14, 2)

  @@index([statementId])
}

model Adjustment {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  adjDate    DateTime       @db.Date
  type       AdjustmentType
  amount     Decimal        @db.Decimal(14, 2)
  reason     String
  createdAt  DateTime       @default(now())
  createdBy  String?
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?

  @@index([customerId, adjDate])
}

model AccountingPeriod {
  id           String       @id @default(cuid())
  period       String       @unique @db.VarChar(7)
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?
  needsReclose Boolean      @default(false)
}

model MonthlyStatement {
  id                String              @id @default(cuid())
  statementNo       String              @unique
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id])
  period            String              @db.VarChar(7)
  version           Int
  startDate         DateTime            @db.Date
  endDate           DateTime            @db.Date
  openingBalance    Decimal             @db.Decimal(14, 2)
  totalBandhi       Decimal             @db.Decimal(14, 2)
  totalMandi        Decimal             @db.Decimal(14, 2)
  totalMilk         Decimal             @db.Decimal(14, 2)
  additionalCharges Decimal             @db.Decimal(14, 2)
  payments          Decimal             @db.Decimal(14, 2)
  credits           Decimal             @db.Decimal(14, 2)
  closingBalance    Decimal             @db.Decimal(14, 2)
  bandhiTotals      Json
  mandiTotals       Json
  status            StatementStatus     @default(FINAL)
  paidStatus        PaidStatus          @default(UNPAID)
  generatedAt       DateTime            @default(now())
  generatedBy       String?
  allocations       PaymentAllocation[]

  @@unique([customerId, period, version])
  @@index([period])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  nameEn   String    @unique
  nameUr   String
  isActive Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id             String          @id @default(cuid())
  expenseDate    DateTime        @db.Date
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  description    String
  amount         Decimal         @db.Decimal(14, 2)
  method         PaymentMethod   @default(CASH)
  notes          String?
  attachmentPath String?
  attachmentName String?
  createdAt      DateTime        @default(now())
  createdBy      String?
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?

  @@index([expenseDate])
  @@index([categoryId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model BusinessSetting {
  key   String @id
  value Json
}

/// Gap-free human-readable number sequences (LG-2026-000123, RC-2026-000001, ST-…)
model Counter {
  key   String @id
  value Int    @default(0)
}
